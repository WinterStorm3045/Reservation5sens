<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Preuve d’achat — Cinq sens</title>
  <style>
    :root {
      color-scheme: light;
      --ink: #26392f;
      --muted: #68756c;
      --paper: #f5f1e8;
      --accent: #75664c;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 48px 20px;
      background: var(--paper);
      color: var(--ink);
      font: 16px/1.6 "Segoe UI", "Helvetica Neue", sans-serif;
    }
    main {
      max-width: 680px;
      margin: 0 auto;
      padding: 48px;
      border: 1px solid rgba(38, 57, 47, .16);
      border-radius: 18px;
      background: #fffdf8;
      box-shadow: 0 16px 38px rgba(38, 57, 47, .08);
    }
    .eyebrow {
      margin: 0 0 8px;
      color: var(--accent);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .14em;
      text-transform: uppercase;
    }
    h1 {
      margin: 0;
      font: 400 clamp(34px, 7vw, 52px)/1.1 Georgia, "Times New Roman", serif;
    }
    .intro { color: var(--muted); }
    dl {
      display: grid;
      grid-template-columns: minmax(150px, .7fr) 1.3fr;
      gap: 12px 20px;
      margin: 32px 0;
      padding: 24px 0;
      border-top: 1px solid rgba(38, 57, 47, .16);
      border-bottom: 1px solid rgba(38, 57, 47, .16);
    }
    dt { color: var(--muted); }
    dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
    .total {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      font: 400 24px Georgia, "Times New Roman", serif;
    }
    footer {
      margin-top: 36px;
      color: var(--muted);
      font-size: 13px;
    }
    @media (max-width: 520px) {
      body { padding: 20px 12px; }
      main { padding: 28px 20px; }
      dl { grid-template-columns: 1fr; gap: 4px; }
      dd { margin-bottom: 12px; }
    }
    @media print {
      body { padding: 0; background: white; }
      main { max-width: none; padding: 24px; border: 0; box-shadow: none; }
    }
  </style>
</head>
<body>
  <main>
    <p class="eyebrow">Cinq sens · Apéro dînatoire</p>
    <h1>Preuve d’achat</h1>
    <p class="intro">Statut de la réservation : <strong><%= status %></strong>.</p>
    <dl>
      <dt>Nom</dt>
      <dd><%= reservation.nom %></dd>
      <dt>Prénom</dt>
      <dd><%= reservation.prenom %></dd>
      <dt>Nombre de participants</dt>
      <dd><%= reservation.nombrePersonnes %></dd>
      <dt>Tarifs sélectionnés</dt>
      <dd><%= tarifs.map((tarif) => tarif === "interne" || tarif === "reduit" ? "Tarif réduit" : tarif === "offert" ? "Offert" : "Tarif extérieur").join(", ") %></dd>
      <dt>Restrictions et autres allergies alimentaires</dt>
      <dd><%= reservation.allergies || "Aucune restriction ni allergie indiquée" %></dd>
    </dl>
    <p class="total"><strong>Total buffets à prépayer</strong><span><%= reservation.totalBuffets %> €</span></p>
    <footer>Conservez ce document comme preuve de votre réservation.</footer>
  </main>
</body>
</html>
